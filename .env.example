# Server-side orchestration. Never expose TRIGGER_SECRET_KEY to the browser.
TRIGGER_API_URL=https://trigger.v1su4.dev
TRIGGER_SECRET_KEY=

# RustFS media gateway used by Next.js routes before dispatching Trigger tasks.
MEDIA_GATEWAY_URL=https://media.v1su4.dev
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_BUCKET=stack-structure
MEDIA_GATEWAY_USER_ID=stack-structure
MEDIA_GATEWAY_UPLOAD_PREFIX=media-uploads

# Smart scene captions. The gateway token remains server-side.
SCENE_CAPTION_SMART_GATEWAY_URL=https://caption.v1su4.dev
SCENE_CAPTION_SMART_GATEWAY_TOKEN=

# Optional direct service configuration for local probes and legacy routes.
ESSENTIA_API_URL=https://essentia.v1su4.dev
ESSENTIA_API_KEY=
