# Copy to .env for local development only. Never commit real values.
# Service URLs and secrets: set in your local .env.local (git-ignored).

# GitHub OAuth application + session signing. All API routes require a session.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
# Canonical origin of the deployment (e.g. http://127.0.0.1:3000 locally,
# https://project-stack-structure.vercel.app in production). Required outside localhost.
AUTH_URL=
AUTH_TRUST_HOST=true

# Server-side orchestration. Never expose TRIGGER_SECRET_KEY to the browser.
TRIGGER_API_URL=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# RustFS media gateway used by Next.js routes before dispatching Trigger tasks.
MEDIA_GATEWAY_URL=
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_BUCKET=
MEDIA_GATEWAY_USER_ID=
MEDIA_GATEWAY_UPLOAD_PREFIX=
# Optional non-proxied gateway address for worker-side data transfers (bypasses
# reverse-proxy body limits on large uploads).
MEDIA_GATEWAY_INTERNAL_URL=

# Server-only signing for browser-to-RustFS multipart uploads.
RUSTFS_S3_ENDPOINT=
RUSTFS_REGION=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Smart and fast scene-caption gateways. Tokens remain server-side.
SCENE_CAPTION_SMART_GATEWAY_URL=
SCENE_CAPTION_SMART_GATEWAY_TOKEN=
SCENE_CAPTION_FAST_GATEWAY_URL=
SCENE_CAPTION_FAST_GATEWAY_TOKEN=

# Optional direct service configuration for local probes and legacy routes.
ESSENTIA_API_URL=
ESSENTIA_API_KEY=
FFMPEG_GATEWAY_URL=
FFMPEG_GATEWAY_API_KEY=
DEEPGRAM_API_KEY=

# Story treatments use SCENE_CAPTION_SMART_GATEWAY_URL + Trigger.dev (qwen-story-treatment).
# Optional override for the gateway route path (default /story/treatments).
# STORY_TREATMENT_GATEWAY_ENDPOINT=/story/treatments

# Public host of durable gateway assets (s3-style URLs). Server-side allowlists
# for FFglitch and Higgsfield image inputs accept these hosts plus
# MEDIA_GATEWAY_URL. Comma-separated extras may extend the list.
MEDIA_GATEWAY_PUBLIC_URL=
FFGLITCH_ALLOWED_INPUT_HOSTS=
HIGGSFIELD_ALLOWED_IMAGE_HOSTS=
HIGGSFIELD_CREDENTIALS_JSON=
HIGGSFIELD_WORKSPACE_ID=

# Private desktop generation (SwarmUI). Set SWARMUI_URL in .env.local (git-ignored).
SWARMUI_URL=
IMAGE_SPLITTER_URL=
IMAGE_SPLITTER_ACCESS_CODE=
