# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.local-fixtures/

# local research scratch (not committed)
.research/
_repo-research/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the value-free template is intentionally tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Higgsfield dedicated account credentials
.higgsfield-stack-structure.json
.higgsfield-stack-structure.json.lock
.tmp/
.trigger/

# tool/QA artifacts (untracked 2026-08-23 deslop)
/.omo/
/output/
/test-results/
/public/qa-media/
.next-dev*.log

# e2e browser artifacts + local test media (never tracked)
.playwright-mcp/
media-to-test-with/
e2e-ingest-state.png
story-state.jpeg

# Cursor: repo MCP overrides (remote Higgsfield etc.) — copy from proxmox-home/cursor/templates/mcp-higgsfield.json locally
.cursor/mcp.json
