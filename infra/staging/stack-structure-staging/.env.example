# Official Qwen Hugging Face source. Use Q4_K_M for the language model and
# Q8_0 for the vision projector; do not substitute FP16 or Ollama.
TRIGGER_API_URL=https://trigger.v1su4.dev
TRIGGER_SECRET_KEY=
TRIGGER_DEV_BRANCH=
MEDIA_GATEWAY_URL=https://media.v1su4.dev
MEDIA_GATEWAY_TOKEN=
SWARMUI_URL=http://100.73.126.36:7861
# Optional installed SwarmUI image model override. If blank, the Trigger task discovers a local non-FP16 image model via /API/ListModels.
SWARMUI_MODEL=
SCENE_CAPTION_SMART_GATEWAY_URL=http://127.0.0.1:18091
FFMPEG_GATEWAY_URL=
FFMPEG_GATEWAY_API_KEY=

QWEN_HF_REPO=https://huggingface.co/Qwen/Qwen3-VL-4B-Instruct-GGUF
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13-b9445@sha256:56095506826cc6287d1b3a8448d8e89dbcef739adac92073967e68984d9c7ab5
QWEN_MODEL_DIR=D:/models/LLM/GGUF/Qwen/Qwen3-VL-4B-Instruct-GGUF
QWEN_MODEL_FILE=Qwen3VL-4B-Instruct-Q4_K_M.gguf
QWEN_MMPROJ_FILE=mmproj-Qwen3VL-4B-Instruct-Q8_0.gguf
QWEN_GPU_LAYERS=24
QWEN_GGUF_MODEL=Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M

# The model and caption ports are loopback-only on Windows. Other containers
# use the Compose service name, not the host-published port.
QWEN_HOST_PORT=18092
CAPTION_HOST_PORT=18091
CAPTION_API_TOKEN=
QWEN_MAX_TOKENS=180
QWEN_TEMPERATURE=0.5
QWEN_TIMEOUT_SECONDS=300
GPU_LOCK_TIMEOUT_SECONDS=900

# Optional local video worker image. Until this is set, the existing media
# gateway remains the media service while Trigger owns orchestration.
STACK_STRUCTURE_MEDIA_WORKER_IMAGE=stack-structure-video-worker:staging
MEDIA_API_URL=https://media.v1su4.dev
MEDIA_API_TOKEN=
MEDIA_WORKER_REQUIRE_GPU=false
MEDIA_WORKER_FFMPEG_HWACCEL=none
MEDIA_WORKER_EXTRACT_CLIPS=true
MEDIA_WORKER_HOST_PORT=18090
MEDIA_WORKER_POLL_SECONDS=3
MEDIA_WORKER_URL=http://127.0.0.1:18090
MEDIA_WORKER_API_TOKEN=
